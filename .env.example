# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# RAZORPAY & CLOUDFLARE PAGES ENVIRONMENT VARIABLES
# ==============================================================================
# In Cloudflare Pages Dashboard:
# Go to: Workers & Pages -> your-project -> Settings -> Environment Variables & Secrets
#
# 1. Plain text environment variable:
# RAZORPAY_KEY_ID: Your public Razorpay Key ID (e.g. rzp_live_xxxxxxxxxxxxxx or rzp_test_xxxxxxxxxxxxxx)
RAZORPAY_KEY_ID="rzp_test_or_live_key_id"
VITE_RAZORPAY_KEY_ID="rzp_test_or_live_key_id"

# 2. ENCRYPTED SECRET (Never commit or share in git):
# RAZORPAY_KEY_SECRET: Your private Razorpay Key Secret from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# 3. ENCRYPTED SECRET (Optional, for webhooks):
# RAZORPAY_WEBHOOK_SECRET: Secret configured in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# 4. Optional: Firebase Service Account JSON string for Cloudflare Functions direct Firestore REST access:
# FIREBASE_PROJECT_ID="zypso-mart-cd989"
# FIREBASE_SERVICE_ACCOUNT='{"client_email":"...","private_key":"..."}'
