rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.matches('(?i)^sonkarrajeevkumar36@gmail\\.com$') ||
        request.auth.token.admin == true
      );
    }

    // Public catalog read, authenticated admin write
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{prodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shopControl/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer orders
    match /orders/{orderId} {
      // Users can read their own orders; admins can read all; guests can read orders they placed
      allow read: if (isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin())) || !isAuthenticated();

      // Authenticated users (including anonymous guests) can create orders; unauthenticated guests can create orders with contact details
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) || (!isAuthenticated() && request.resource.data.customerPhone != null && request.resource.data.customerAddress != null);

      // Customers can update their own order status for payment completion, cancellations or returns
      // Admins can update all fields/statuses
      allow update: if (
        (
          isAuthenticated() &&
          (resource.data.userId == request.auth.uid || isAdmin()) &&
          (
            request.resource.data.status in ['cancelled', 'return_requested', 'return_pending', 'placed'] || isAdmin()
          )
        ) ||
        (
          !isAuthenticated() &&
          request.resource.data.status in ['cancelled', 'return_requested', 'return_pending', 'placed']
        ) ||
        isAdmin()
      );

      // Only administrators can delete orders
      allow delete: if isAdmin();
    }
  }
}
