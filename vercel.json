{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|sw\\.js|manifest\\.json|favicon\\.ico|favicon\\.png|apple-touch-icon\\.png|pwa-.*|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
